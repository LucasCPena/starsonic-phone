[Unit]
Description=Starsonic Chat, o servidor do chat interno
After=network-online.target
Wants=network-online.target

[Service]
User=starsonic-chat
Group=starsonic-chat
ExecStart=/usr/local/bin/starsonic-chat servir --config /etc/starsonic-chat/config.json
Restart=on-failure
RestartSec=5

# Pode abrir as portas 80 e 443, e nada mais.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Só o dono lê o banco e os arquivos: tudo guarda as mensagens.
UMask=0077
StateDirectory=starsonic-chat
StateDirectoryMode=0700
ReadWritePaths=/var/lib/starsonic-chat

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
