<?xml version="1.0" encoding="utf-8"?>
<!-- Só no build de debug: o canal de teste do atualizador (UpdatePromptTest) vem por HTTP sem TLS de 10.0.2.2, o
     computador que roda o emulador (res/xml/network_security_config.xml deste build). O build de release não tem
     isto: o Android só deixa HTTPS (targetSdk 28 ou mais). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
