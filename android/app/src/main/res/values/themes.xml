<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- O app segue o modo claro ou escuro do celular (values-night), com os dois temas dele: o fundo da janela é o
         surface de cada um, e o escurecimento forçado dos fabricantes fica desligado. -->
    <style name="Theme.Starsonic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- A tela da ligação e a recebida, sempre escuras (spec 3.1): o tema escuro nos dois modos do celular, com o fundo
         navy da janela, para a tela não piscar em branco por cima da tela bloqueada antes de o Compose desenhar. -->
    <style name="Theme.Starsonic.Call" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/starsonic_navy_900</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- Tela de abertura: o fundo navy-950 (o começo do gradiente do cabeçalho, que vem logo depois) com o ícone; depois,
         o tema do app. -->
    <style name="Theme.Starsonic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/starsonic_navy_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Starsonic</item>
    </style>
</resources>
