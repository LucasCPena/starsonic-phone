[Unit]
Description=Starsonic Vídeo, o agente do servidor de vídeo das reuniões
After=network-online.target starsonic-freeswitch.service
Wants=network-online.target starsonic-freeswitch.service

[Service]
User=starsonic-video
Group=starsonic-video
ExecStart=/usr/local/bin/starsonic-video servir --config /etc/starsonic-video/config.json
# O SIGHUP relê o certificado e manda ao FreeSWITCH o reloadcert: o gancho do certbot recarrega por aqui.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Pode abrir a porta 443, e nada mais.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# O agente não escreve nada: os registros vão para o journal.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
