<?xml version="1.0" encoding="utf-8"?>
<!-- Starsonic Phone: importado no fim de microsip/microsip.vcxproj (edicao E3). -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Build-App.ps1 tambem passa /p:TargetName na linha de comando, para valer desde o inicio da avaliacao. -->
    <TargetName>StarsonicPhone</TargetName>
    <StarsonicVcpkgRoot Condition="'$(StarsonicVcpkgRoot)'==''">$(MSBuildThisFileDirectory)..\..\vcpkg\installed\x86-windows-static</StarsonicVcpkgRoot>
    <StarsonicDir>$(MSBuildThisFileDirectory)</StarsonicDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(StarsonicVcpkgRoot)\include;$(StarsonicDir);$(StarsonicDir)core;$(StarsonicDir)win;$(StarsonicDir)third_party;$(StarsonicDir)third_party\openh264\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(StarsonicDir)win;$(StarsonicDir)generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <!-- A PJSIP com o video: o vpx.lib (que ela pede por #pragma comment) vem da pasta lib do vcpkg; o openh264.lib que
         ela tambem pede fica de fora, e as quatro funcoes do OpenH264 vem do win\OpenH264Stub.cpp (o app antigo nao
         tem video). -->
    <Link>
      <AdditionalLibraryDirectories>$(StarsonicVcpkgRoot)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opus.lib;bcg729.lib;libssl.lib;libcrypto.lib;crypt32.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <IgnoreSpecificDefaultLibraries>openh264.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Nucleo: C++14 puro, sem cabecalho pre-compilado. -->
    <ClCompile Include="$(StarsonicDir)core\*.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ObjectFileName>$(IntDir)starsonic\core\</ObjectFileName>
    </ClCompile>
    <!-- Integracao com o MicroSIP: usa o stdafx.h do projeto. O LegacyCrypto.cpp (C++17, a migracao da rc.7) e do
         app novo, nao deste. -->
    <ClCompile Include="$(StarsonicDir)win\*.cpp" Exclude="$(StarsonicDir)win\LegacyCrypto.cpp">
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>stdafx.h</PrecompiledHeaderFile>
      <ObjectFileName>$(IntDir)starsonic\win\</ObjectFileName>
    </ClCompile>
    <ResourceCompile Include="$(StarsonicDir)win\starsonic.rc" />
  </ItemGroup>
  <ItemGroup>
    <!-- Win32 puro, sem MFC (tambem compilados nos testes e no app novo, windows/app): o stdafx.h do MicroSIP traz o
         wininet.h (afxinet.h), que nao convive com o winhttp.h. O adaptador do atualizador para o MicroSIP fica no
         Hooks.cpp. -->
    <ClCompile Update="$(StarsonicDir)win\Sha256.cpp;$(StarsonicDir)win\Http.cpp;$(StarsonicDir)win\Updater.cpp;$(StarsonicDir)win\TlsWatch.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- As funcoes do OpenH264 sem o modulo, so do app antigo: Win32 puro tambem. -->
    <ClCompile Update="$(StarsonicDir)win\OpenH264Stub.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
</Project>
